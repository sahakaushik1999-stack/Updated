# Server configuration
PORT=3000
NODE_ENV=development

# Optional Gemini API key if using AI Studio GenAI capabilities
GEMINI_API_KEY=

# ==============================================================================
# Cloudflare R2 Object Storage Configuration
# ==============================================================================
# To configure permanent media storage with Cloudflare R2:
# 1. Log in to the Cloudflare dashboard (dash.cloudflare.com)
# 2. In the left navigation, go to "R2" -> "Overview"
# 3. Create a bucket (e.g. "portfolio-media")
# 4. Under "Manage R2 API Tokens" on the right sidebar:
#    - Click "Create API token"
#    - Select "Object Read & Write" permission
#    - Specify your bucket or "All buckets"
#    - Copy your Access Key ID and Secret Access Key
# 5. Find your Account ID in the R2 dashboard URL or the right sidebar
# 6. For production public delivery:
#    - In your bucket settings, go to "Settings" -> "Public Access"
#    - Either connect a Custom Domain (e.g., https://media.yourportfolio.com) (RECOMMENDED FOR PRODUCTION)
#    - Or enable the "R2.dev subdomain" (e.g., https://pub-xxxxxx.r2.dev)
# ==============================================================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom Domain (recommended for production) or R2.dev public URL (e.g. https://media.yourportfolio.com)
R2_PUBLIC_DOMAIN=
